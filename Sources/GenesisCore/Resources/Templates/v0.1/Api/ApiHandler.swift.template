import DDDCore
import Foundation
import KurrentDB
import OpenAPIRuntime
{SharedImport}


package struct ApiHandler: APIProtocol {

    private let kdbClient: KurrentDBClient
    private var repository: {A}Repository {
        return .init(coordinator: .init(client: kdbClient, eventMapper: {A}AggregateEventMapper()))
    }

    package init(kdbClient: KurrentDBClient) {
        self.kdbClient = kdbClient
    }

    private func mapToApiError(_ error: Error) -> Components.Schemas.{A}ApiError? {
        if let contextError = error as? ContextError<{A}Error> {
            return .init(from: contextError)
        }
        return nil
    }

    /// Registers this handler's operations on `transport` (e.g. a Hummingbird `Router`).
    /// The generated `registerHandlers` is `internal` (see openapi-generator-config.yaml:
    /// `accessModifier: internal` keeps the generator's imports non-`package`, which Swift 6.4
    /// rejects when mixed with plain `import Foundation`), so the Server target calls this
    /// `package` forwarder instead.
    package func registerApiHandlers(
        on transport: any ServerTransport,
        serverURL: URL = .defaultOpenAPIServerURL,
        middlewares: [any ServerMiddleware] = []
    ) throws {
        try registerHandlers(on: transport, serverURL: serverURL, middlewares: middlewares)
    }

{UC_HANDLER_METHODS}
}
